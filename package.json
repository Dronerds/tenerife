{
  "name": "tenerife",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The Tenerife demo flight rebuilt on CesiumJS — comparison branch, not for merge",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "node tools/capture.mjs",
    "postinstall": "node tools/copy-cesium-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "cesium": "^1.144.0"
  }
}
